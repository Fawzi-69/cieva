# Cle API Anthropic (obligatoire pour les suggestions)
ANTHROPIC_API_KEY=sk-ant-...

# Modele. Laisser tel quel sauf raison precise.
COPILOT_MODEL=claude-opus-5

# Mode rapide (Opus 5) : ~2.5x plus de tokens/s, tarif premium. 1 pour activer.
COPILOT_FAST=0

# Transcription en streaming, un flux par locuteur (Eux / Vous).
# Sans cette cle : repli Web Speech API, un seul canal, micro par defaut du
# systeme, et le choix d'appareil est sans effet.
DEEPGRAM_API_KEY=

# Pour viser un Deepgram auto-heberge, ou tout service parlant le meme
# protocole. Laisser vide pour le service public.
DEEPGRAM_URL=

# Reseau. 127.0.0.1 = accessible seulement depuis cette machine (recommande).
PORT=4321
HOST=127.0.0.1
